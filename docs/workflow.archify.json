{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "天猫经营数据自动化工作流",
    "output": "docs/workflow.html",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "stages": [
    {"label": "增量取数"},
    {"label": "幂等入库"},
    {"label": "计算与门禁"},
    {"label": "生成与保护"},
    {"label": "发布与分析"}
  ],
  "nodes": [
    {"id": "qwen", "type": "external", "label": "千问取数", "sublabel": "生意参谋·万相台·羚羊", "stage": 0, "row": 1, "tag": "只补增量"},
    {"id": "ingest", "type": "backend", "label": "增量接入", "sublabel": "文件哈希与业务主键", "stage": 1, "row": 0, "tag": "重复跳过"},
    {"id": "facts", "type": "database", "label": "SQLite事实库", "sublabel": "日事实·维度·归因修订", "stage": 1, "row": 2, "tag": "唯一事实源"},
    {"id": "compute", "type": "backend", "label": "确定性计算", "sublabel": "月度·同比·ROI·商品聚合", "stage": 2, "row": 0, "tag": "固定代码"},
    {"id": "gate", "type": "security", "label": "质量门禁", "sublabel": "新鲜度·覆盖率·跨表对账", "stage": 2, "row": 2, "tag": "不填零"},
    {"id": "html", "type": "frontend", "label": "单文件看板", "sublabel": "固定模板与两段业务数据", "stage": 3, "row": 0, "tag": "脚本生成"},
    {"id": "report", "type": "backend", "label": "经营日报", "sublabel": "与看板使用同一事实源", "stage": 3, "row": 2, "tag": "自动复核"},
    {"id": "protect", "type": "security", "label": "发布保护", "sublabel": "失败停止·无变化跳过", "stage": 3, "row": 4, "tag": "可逆"},
    {"id": "dashboard", "type": "cloud", "label": "固定线上看板", "sublabel": "原链接更新并回读验证", "stage": 4, "row": 0, "tag": "保留页面壳"},
    {"id": "analysis", "type": "external", "label": "AI经营分析", "sublabel": "异常解释·洞察·动作建议", "stage": 4, "row": 2, "tag": "不重算事实"},
    {"id": "previous", "type": "cloud", "label": "线上上一版", "sublabel": "错误数据不覆盖", "stage": 4, "row": 4, "tag": "稳定可用"}
  ],
  "flows": [
    {"id": "source-increment", "from": "qwen", "to": "ingest", "label": "增量CSV与JSON", "variant": "emphasis"},
    {"id": "ingest-facts", "from": "ingest", "to": "facts", "label": "幂等写入", "variant": "emphasis"},
    {"id": "facts-compute", "from": "facts", "to": "compute", "label": "统一事实", "variant": "emphasis"},
    {"id": "compute-gate", "from": "compute", "to": "gate", "label": "指标与对账", "variant": "emphasis"},
    {"id": "gate-html", "from": "gate", "to": "html", "label": "通过后生成", "variant": "emphasis"},
    {"id": "html-dashboard", "from": "html", "to": "dashboard", "label": "最小差异发布", "variant": "emphasis"},
    {"id": "gate-report", "from": "gate", "to": "report", "label": "同源数据结果"},
    {"id": "report-analysis", "from": "report", "to": "analysis", "label": "日报与异常"},
    {"id": "gate-protect", "from": "gate", "to": "protect", "label": "失败或没变化", "variant": "security"},
    {"id": "protect-previous", "from": "protect", "to": "previous", "label": "保留可用版本", "variant": "security"}
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "职责分离",
      "items": [
        "千问负责取数，脚本负责计算，AI负责分析",
        "稳定历史不重复抓，万相台近端归因按主键覆盖",
        "页面与日报不再各自维护一套数字"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据诚信",
      "items": [
        "缺失不填零，不跨终端或归属口径拼接",
        "TOP榜不冒充全量，窗口汇总不均摊成日事实",
        "每次入库和发布都有校验与回读证据"
      ]
    }
  ]
}
